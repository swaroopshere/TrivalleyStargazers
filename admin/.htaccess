# Protect admin directory
# Allow PHP files to execute
<FilesMatch "\.php$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Deny access to config files
<FilesMatch "^(config|auth)\.php$">
    Order deny,allow
    Deny from all
</FilesMatch>

# Optional: Require authentication for entire directory
# Uncomment the following lines if your server supports it
# AuthType Basic
# AuthName "Newsletter Admin"
# AuthUserFile /path/to/.htpasswd
# Require valid-user

